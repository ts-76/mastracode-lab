{
  "name": "@ts-76/mastra-mono",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "scripts",
    "README.md",
    "CHANGELOG.md",
    "package.json"
  ],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/ts-76/mastra-mono.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "bin": {
    "mastra-mono": "dist/cli.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./tui": {
      "import": {
        "types": "./dist/tui/index.d.ts",
        "default": "./dist/tui.js"
      },
      "require": {
        "types": "./dist/tui/index.d.ts",
        "default": "./dist/tui.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "cli": "tsx src/main.ts",
    "build": "tsup --silent --config tsup.config.ts",
    "build:watch": "bun run build --watch",
    "lint": "eslint .",
    "prepack": "bun run build",
    "test": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "mastra",
    "tui",
    "coding-agent"
  ],
  "author": "ts-76",
  "license": "Apache-2.0",
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.58",
    "@ai-sdk/openai": "^3.0.41",
    "@ast-grep/napi": "^0.42.0",
    "@mariozechner/pi-tui": "^0.60.0",
    "@mastra/core": "^1.22.0",
    "@mastra/fastembed": "^1.0.1",
    "@mastra/libsql": "^1.7.4",
    "@mastra/mcp": "^1.4.1",
    "@mastra/memory": "^1.13.1",
    "@mastra/pg": "^1.8.6",
    "@tavily/core": "^0.7.2",
    "ai": "^6.0.116",
    "chalk": "^5.5.0",
    "cli-highlight": "^2.1.11",
    "execa": "^9.6.1",
    "fastest-levenshtein": "^1.0.16",
    "js-tiktoken": "^1.0.21",
    "partial-json": "^0.1.7",
    "strip-ansi": "^7.2.0",
    "tree-kill": "^1.2.2",
    "vscode-jsonrpc": "^8.2.1",
    "vscode-languageserver-protocol": "^3.17.5",
    "yaml": "^2.7.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "22.19.15",
    "@vitest/coverage-v8": "^4.1.2",
    "@vitest/ui": "^4.1.2",
    "eslint": "^9.39.4",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
